# Backend environment template. Copy to .env to override defaults.
# The platform is offline-first: with NO .env at all it boots on SQLite with an
# in-process cache and a deterministic agent (no API keys required).

# App
ENVIRONMENT=development

# Auth (JWT) — change JWT_SECRET before any real deployment.
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database. Default (unset) = local SQLite file. Docker uses PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/platform
DATABASE_URL=sqlite:///./platform.db

# Redis (optional). Leave empty to use the in-process session cache.
# REDIS_URL=redis://redis:6379/0
REDIS_URL=

# CORS — comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:4200

# Seed a demo org + user (demo@acme.com / demopass123) on first startup.
SEED_DEMO_DATA=true
