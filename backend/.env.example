# Backend environment template. Copy to .env and fill in real values.
# TODO: checklist "Backend: FastAPI services + PostgreSQL + Redis".

# App
ENVIRONMENT=development

# Auth (JWT)
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/platform

# Redis
REDIS_URL=redis://redis:6379/0

# Vector store (Qdrant / pgvector)
VECTOR_URL=http://qdrant:6333

# LLM / provider keys — TODO: add the keys your LangGraph agents need
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
